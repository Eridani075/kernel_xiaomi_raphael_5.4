# Platform
CONFIG_MACH_XIAOMI_RAPHAEL=y

# Camera motor
CONFIG_TI_DRV8846=y

# Sensors
CONFIG_AKM09970=y

# Touch
CONFIG_TOUCHSCREEN_GOODIX_GTX8=y

# TFA9874 smart amp - use the DAVI (MI2S TX hostless) path that the stock kernel ships with
CONFIG_SND_SOC_TFA9874=y
CONFIG_SND_SOC_TFA9874_FOR_DAVI=y

# Identify experimental builds separately from the RaphGhost baseline.
CONFIG_LOCALVERSION="-cnb-5.4-soviet"

# hvdcp_opti finds the SMB1390 through IIO only with the PSY driver.
# CONFIG_SMB1390_CHARGE_PUMP is not set
CONFIG_SMB1390_CHARGE_PUMP_PSY=y
